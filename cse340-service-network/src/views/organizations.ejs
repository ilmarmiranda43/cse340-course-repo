<%- include('partials/header') %>

  <main class="container page-content">
    <p class="eyebrow">Our community</p>

    <h1>
      <%= title %>
    </h1>

    <p>Here are a few of our partner organizations:</p>

    <div class="card-grid">
      <% if (organizations && organizations.length> 0) { %>

        <% organizations.forEach((org)=> { %>
          <article class="card">

            <a href="/organization/<%= org.organization_id %>" aria-label="View details for <%= org.name %>">
              <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
            </a>

            <h2>
              <a class="organization-title-link" href="/organization/<%= org.organization_id %>">
                <%= org.name %>
              </a>
            </h2>

            <p>
              <%= org.description %>
            </p>

            <p>
              <a href="mailto:<%= org.contact_email %>">
                <%= org.contact_email %>
              </a>
            </p>

            <a class="organization-details-link" href="/organization/<%= org.organization_id %>">
              View Organization Details &rarr;
            </a>

          </article>
          <% }); %>

            <% } else { %>
              <p>No partner organizations available yet.</p>
              <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>