<%- include('partials/header') %>

  <main class="container page-content">
    <p class="eyebrow">Our community</p>
    <h1>
      <%= title %>
    </h1>
    <p>Here are a few of our partner organizations:</p>

    <div class="card-grid">
      <% if (organizations && organizations.length> 0) { %>
        <% organizations.forEach((org)=> { %>
          <article class="card">
            <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
            <h2>
              <%= org.name %>
            </h2>
            <p>
              <%= org.description %>
            </p>
            <p><a href="mailto:<%= org.contact_email %>">
                <%= org.contact_email %>
              </a></p>
          </article>
          <% }); %>
            <% } else { %>
              <p>No partner organizations available yet.</p>
              <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>