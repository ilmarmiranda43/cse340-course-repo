<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %> | Service Network
    </title>

    <link rel="stylesheet" href="/css/projects.css">
</head>

<body>

    <header class="site-header">
        <nav class="nav-container" aria-label="Main navigation">

            <a class="brand" href="/">Service Network</a>

            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/organizations">Organizations</a>
                <a href="/projects">Projects</a>
                <a href="/categories">Categories</a>
            </div>

        </nav>
    </header>

    <main class="project-page">

        <div class="page-intro">
            <span class="eyebrow">OUR COMMUNITY PARTNERS</span>

            <h1>
                <%= organization.name %>
            </h1>

            <p>
                Meet one of the organizations helping
                make our community stronger.
            </p>
        </div>

        <article class="detail-card organization-detail-card">

            <% if (organization.logo_filename) { %>
                <div class="organization-logo-container">

                    <img class="organization-logo" src="/images/<%= organization.logo_filename %>"
                        alt="<%= organization.name %> logo">

                </div>
                <% } %>

                    <span class="card-tag">PARTNER ORGANIZATION</span>

                    <h2>About the Organization</h2>

                    <p class="detail-description">
                        <%= organization.description || 'No description available.' %>
                    </p>

                    <% if (organization.contact_email) { %>
                        <div class="detail-organization">

                            <span class="detail-label">CONTACT EMAIL</span>

                            <p>
                                <a class="organization-email" href="mailto:<%= organization.contact_email %>">
                                    <%= organization.contact_email %>
                                </a>
                            </p>

                        </div>
                        <% } %>

                            <!-- ORGANIZATION SERVICE PROJECTS - WEEK 03 -->
                            <section class="detail-organization">

                                <span class="detail-label">OUR SERVICE PROJECTS</span>

                                <% if (projects && projects.length> 0) { %>

                                    <ul class="related-projects">
                                        <% projects.forEach((project)=> { %>
                                            <li>
                                                <a href="/project/<%= project.project_id %>">
                                                    <%= project.title %>
                                                </a>
                                            </li>
                                            <% }); %>
                                    </ul>

                                    <% } else { %>
                                        <p>No service projects registered yet.</p>
                                        <% } %>

                            </section>

        </article>


        <div class="detail-navigation">
            <a class="back-link" href="/organizations">
                &larr; Back to Organizations
            </a>

            <a class="secondary-link" href="/projects">
                Explore Upcoming Projects &rarr;
            </a>
        </div>

    </main>

</body>

</html>