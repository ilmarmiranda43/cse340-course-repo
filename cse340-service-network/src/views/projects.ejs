<%- include('partials/header') %>

  <main class="container page-content">
    <p class="eyebrow">Make a difference</p>

    <h1>
      <%= title %>
    </h1>
    <h2>Upcoming Service Projects</h2>

    <div class="card-grid">
      <% if (projects && projects.length> 0) { %>
        <% projects.forEach((project)=> { %>

          <article class="card">
            <h3>
              <%= project.title %>
            </h3>

            <p>
              <%= project.description %>
            </p>

            <p>
              <strong>Organization:</strong>
              <%= project.organization_name %>
            </p>

            <p>
              <strong>Location:</strong>
              <%= project.location %>
            </p>

            <p>
              <strong>Date:</strong>
              <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC' , year: 'numeric' , month: 'long'
                , day: 'numeric' }) %>
            </p>
          </article>

          <% }); %>
            <% } else { %>
              <p>No service projects are available.</p>
              <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>