<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <article class="card">
      <h1><%= project.title %></h1>
      <p><%= project.description %></p>
      <p><strong>Date:</strong> <%= project.date instanceof Date ? project.date.toISOString().slice(0, 10) : String(project.date).slice(0, 10) %></p>
      <p><strong>Location:</strong> <%= project.location %></p>
      <p>
        <strong>Partner organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
      </p>
      <p><a href="/projects">Back to upcoming projects</a></p>
    </article>
  </main>
</body>
</html>
