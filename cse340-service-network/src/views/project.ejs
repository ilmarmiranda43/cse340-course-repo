<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    <%= title %> | Service Network
  </title>

  <link rel="stylesheet" href="/css/projects.css">
</head>

<body>

  <header class="site-header">
    <nav class="nav-container" aria-label="Main navigation">

      <a class="brand" href="/">Service Network</a>

      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Projects</a>
        <a href="/categories">Categories</a>
      </div>

    </nav>
  </header>

  <main class="project-page">

    <div class="page-intro">
      <span class="eyebrow">PROJECT DETAILS</span>
      <h1>
        <%= project.title %>
      </h1>

      <p>
        Learn more about this service opportunity
        and the organization behind it.
      </p>
    </div>

    <article class="detail-card">

      <span class="card-tag">COMMUNITY SERVICE</span>

      <h2>About This Project</h2>

      <p class="detail-description">
        <%= project.description %>
      </p>

      <div class="detail-info-grid">

        <div class="detail-info-item">
          <span class="detail-label">PROJECT DATE</span>

          <strong>
            <%= new Date(project.date).toISOString().slice(0, 10) %>
          </strong>
        </div>

        <div class="detail-info-item">
          <span class="detail-label">LOCATION</span>

          <strong>
            <%= project.location %>
          </strong>
        </div>

      </div>

      <div class="detail-organization">
        <span class="detail-label">PARTNER ORGANIZATION</span>

        <h3>
          <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
          </a>
        </h3>

        <p>
          Discover more about the organization
          supporting this community project.
        </p>

        <a class="secondary-link" href="/organization/<%= project.organization_id %>">
          View Organization Details &rarr;
        </a>
      </div>

      <!-- PROJECT CATEGORIES - WEEK 03 -->
      <section class="detail-organization">
        <span class="detail-label">PROJECT CATEGORIES</span>

        <% if (categories && categories.length> 0) { %>

          <div class="category-tags">
            <% categories.forEach((category)=> { %>
              <a class="category-tag" href="/category/<%= category.category_id %>">
                <%= category.name %>
              </a>
              <% }); %>
          </div>

          <% } else { %>
            <p>No categories assigned to this project.</p>
            <% } %>
      </section>

    </article>

    </div>

    </article>

    <div class="detail-navigation">
      <a class="back-link" href="/projects">
        &larr; Back to Upcoming Projects
      </a>
    </div>

  </main>

</body>

</html>